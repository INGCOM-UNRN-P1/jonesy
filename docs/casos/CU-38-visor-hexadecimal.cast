[3.391607, "o", "\u001b[8;35H\u001b[38;2;97;175;239;49mV\u001b[9;34H\u001b[1m\u001b[39;48;2;62;68;81mVer documentación \u001b[9;53H        \u001b[9;99H\u001b[38;2;110;118;129;48;2;62;68;81m4\u001b[10;34H\u001b[22m\u001b[39;49mV\u001b[10;36Hlver a\u001b[10;43Hdond\u001b[10;48H estaba\u001b[10;93H  \u001b[38;2;110;118;129;49mA\u001b[10;97Ht+←\u001b[11;34H\u001b[39;49mVista previa de M\u001b[11;52Hrkdown  \u001b[11;93H \u001b[38;2;110;118;129;49mCtrl+P\u001b[12;34H\u001b[39;49mV\u001b[12;36Hr\u001b[12;38Hficar estado de\u001b[12;54Hentrega \u001b[12;63H      \u001b[12;70H \u001b[12;72H        \u001b[13;34HVer ejercicios y objetivos del\u001b[13;65Hproyecto\u001b[13;95H\u001b[38;2;110;118;129;49mAlt+Y\u001b[14;34H\u001b[39;49mVi\u001b[14;38Hr hexadecimal (ej\u001b[14;56Hcutables,\u001b[14;66H.o,\u001b[14;70H.a)…\u001b[14;97H   \u001b[15;34HVer la\u001b[15;41Hprecedencia de la expresión\u001b[15;69H(paréntesis\u001b[15;81Himplícitos)\u001b[15;97H   \u001b[16;34Hv\u001b[16;36Hsquez:\u001b[16;43HProbar el programa con\u001b[16;66Hfallos\u001b[16;73Hinyectados\u001b[16;84H(vasquez check)\u001b[38;2;110;118;129;49mhe\u001b[17;34H\u001b[39;49mMaximizar el panel\u001b[17;53Hactual\u001b[17;60H(y\u001b[17;63Hvolver)\u001b[17;92H   \u001b[38;2;110;118;129;49mAlt+Z\u001b[18;34H\u001b[39;49mInspección visual de memoria\u001b[18;63H(cat-scan)\u001b[18;94H \u001b[38;2;110;118;129;49mAlt\u001b[18;99HM\u001b[19;34H\u001b[39;49mcorb\u001b[19;39Hl: Ver qué falta documentar (corbel\u001b[19;75Hcheck)\u001b[19;89H\u001b[38;2;110;118;129;49mherramienta\u001b[20;34H\u001b[39;49mmake: biblioteca\u001b[20;51Hvector\u001b[20;58H›\u001b[20;60Hall\u001b[20;64H—\u001b[20;66HCompila\u001b[20;74Hla\u001b[20;77Hbiblioteca\u001b[38;2;110;118;129;49mmake -C libs/v\u001b[21;34H\u001b[39;49mcallahan: Verificar\u001b[21;54Hlos\u001b[21;58Hcontratos\u001b[21;68HACSL\u001b[21;73H(callahan\u001b[21;83Hverify)\u001b[38;2;110;118;129;49mherramienta\u001b[22;34H\u001b[39;49mmake:\u001b[22;40Hbibl\u001b[22;45Ho