[2.920152, "o", "\u001b[8;35H        \u001b[9;34H\u001b[1m\u001b[39;48;2;62;68;81mpunte\u001b[9;40Ho — Variable\u001b[9;53Hque\u001b[9;57Hguarda\u001b[9;64Huna\u001b[9;68Hdirección\u001b[9;78Hde\u001b[9;81Hmemoria:\u001b[9;90Hdónde\u001b[9;96Hestá \u001b[10;34H\u001b[22m\u001b[39;49mdir\u001b[10;38Hcció\u001b[10;43H — Posición\u001b[10;55Hde un dato en la memoria.\u001b[10;81HEl operador `&`\u001b[10;98Ha o\u001b[11;34Hdesreferenciar\u001b[11;49H—\u001b[11;51HAcceder\u001b[11;59Hal\u001b[11;62Hdato\u001b[11;67Hal\u001b[11;70Hque\u001b[11;74Hapunta\u001b[11;81Hun\u001b[11;84Hpuntero,\u001b[11;93Hcon\u001b[11;97H`*p`\u001b[12;34HNULL\u001b[12;39H—\u001b[12;41HValor\u001b[12;47Hde\u001b[12;50Hun\u001b[12;53Hpuntero\u001b[12;61Hque\u001b[12;65Hno\u001b[12;68Hapunta\u001b[12;75Ha\u001b[12;77Hnada.\u001b[12;83HLo\u001b[12;86Hdevuelven\u001b[12;96H`mall\u001b[13;34Hstack\u001b[13;40H—\u001b[13;42HZona\u001b[13;47Hde\u001b[13;50Hmemoria\u001b[13;58Hdonde\u001b[13;64Hviven\u001b[13;70Hlas\u001b[13;74Hvariables\u001b[13;84Hlocales\u001b[13;92Hy\u001b[13;94Hlos\u001b[13;98Hpar\u001b[14;34Hheap\u001b[14;39H—\u001b[14;41HZona\u001b[14;46Hde\u001b[14;49Hmemoria\u001b[14;57Hque\u001b[14;61Hse\u001b[14;64Hpide\u001b[14;69Hen\u001b[14;72Htiempo\u001b[14;79Hde\u001b[14;82Hejecución\u001b[14;92Hcon\u001b[14;96H`mall\u001b[15;34Hmalloc\u001b[15;41H—\u001b[15;43HPide\u001b[15;48Hun\u001b[15;51Hbloque\u001b[15;58Hde\u001b[15;61Hmemoria\u001b[15;69Hen\u001b[15;72Hel\u001b[15;75Hheap\u001b[15;80Hy\u001b[15;82Hdevuelve\u001b[15;91Hsu\u001b[15;94Hdirecci\u001b[16;34Hfree\u001b[16;39H—\u001b[16;41HLibera\u001b[16;48Hun\u001b[16;51Hbloque\u001b[16;58Hpedido\u001b[16;65Hcon\u001b[16;69H`malloc`.\u001b[16;79HDespués,\u001b[16;88Hel\u001b[16;91Hpuntero\u001b[16;99Hqu\u001b[17;34Hfuga\u001b[17;39Hde\u001b[17;42Hmemoria\u001b[17;50H—\u001b[17;52HMemoria\u001b[17;60Hpedida\u001b[17;67Hcon\u001b[17;71H`malloc`\u001b[17;80Hque\u001b[17;84Hnunca\u001b[17;90Hse\u001b[17;93Hlibera:\u001b[18;34Hpuntero\u001b[18;42Hcolgante\u001b[18;51H—\u001b[18;53HPuntero\u001b[18;61Hque\u001b[18;65Hapunta\u001b[18;72Ha\u001b[18;74Hmemoria\u001b[18;82Hque\u001b[18;86Hya\u001b[18;89Hno\u001b[18;92Hes\u001b[18;95Hválida\u001b[19;34Huso\u001b[19;38Hdespués\u001b[19;46Hde\u001b[19;49Hfree\u001b[19;54H—\u001b[19;56HLeer\u001b[19;61Ho\u001b[19;63Hescribir\u001b[19;72Hmemoria\u001b[19;80Hque\u001b[19;84Hya\u001b[19;87Hse\u001b[19;90Hliberó.\u001b[19;98HA\u001b[19;100Hv\u001b[20;34Hfree\u001b[20;39Hdoble\u001b[20;45H—\u001b[20;47HLlamar\u001b[20;54Ha\u001b[20;56H`free`\u001b[20;63Hdos\u001b[20;67Hveces\u001b[20;73Hsobre\u001b[20;79Hel\u001b[20;82Hmismo\u001b[20;88Hbloque.\u001b[20;96Hglibc\u001b[21;34Hviolación\u001b[21;44Hde\u001b[21;47Hsegmento\u001b[21;56H—\u001b[21;58HEl\u001b[21;61Hprograma\u001b[21;70Haccedió\u001b[21;78Ha\u001b[21;80Hmemoria\u001b[21;88Hque\u001b[21;92Hno\u001b[21;95Hle\u001b[21;98Hcor\u001b[22;34HSIGABRT\u001b[22;42H—\u001b[22;44HSeñal\u001b[22;50Hcon\u001b[22;54Hla\u001b[22;57Hque\u001b[22;61Hel\u001b[22;64Hprograma\u001b[22;73Hse\u001b[22;76Haborta\u001b[22;83Ha\u001b[22;85Hsí\u001b[22;88Hmismo:\u001b[22;95Hun\u001b[22;98H`as\u001b[23;34Hdesbordamiento\u001b[23;49H—\u001b[23;51HEscribir\u001b[23;60Ho\u001b[23;62Hleer\u001b[23;67Hmás\u001b[23;71Hallá\u001b[23;76Hdel\u001b[23;80Hfinal\u001b[23;86Hde\u001b[23;89Hun\u001b[23;92Harreglo\u001b[23;100Ho\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[8;35H"]
[4.770229, "o", "\u001b[8;35H\u001b[38;2;97;175;239;49mp\u001b[10;34H\u001b[39;49mprotot\u001b[10;41Hpo\u001b[10;46HLa firma\u001b[10;60Ha función sin su cuerpo\u001b[10;84H(`int suma(int a,\u001b[11;34Hpunt\u001b[11;39Hro colg\u001b[11;47Hnte\u001b[11;51H— Puntero que apunta a\u001b[11;74Hmemoria que ya n\u001b[11;91H es válida\u001b[13;34Hfree — Libera un bl\u001b[13;54Hque\u001b[13;58Hpedido con `m\u001b[13;72Hlloc`. Después, el puntero qu\u001b[14;34Hst\u001b[14;37Hck — Zona de memoria dond\u001b[14;64Hv\u001b[14;66Hv\u001b[14;68Hn las variables locales\u001b[14;92Hy los par\u001b[15;34Hstdin — Los tres\u001b[15;51Hcanal\u001b[15;57Hs de un programa:\u001b[15;75Hentrada (`stdin`, el t\u001b[15;99Hla\u001b[16;34Hmalloc\u001b[16;41H— Pide\u001b[16;58Hd\u001b[16;60H memoria\u001b[16;69Hen e\u001b[16;74H heap y devuelve\u001b[16;91Hs\u001b[16;93H di\u001b[16;97Hecci\u001b[17;34Hheader — Arch\u001b[17;48Hvo `.h` con\u001b[17;61Hrototip\u001b[17;69Hs, tipos y\u001b[17;80Hmacros, que se incluy\u001b[18;34Hámbito — La parte del código donde un\u001b[18;72Hno\u001b[18;75Hbre es\u001b[18;82Hvisible: el bloque \u001b[19;34HSIGABRT — Señal con\u001b[19;54Hla que\u001b[19;61Hel programa se aborta a sí mismo: un\u001b[19;98H`as\u001b[20;34Hvalgrind —\u001b[20;45HHerr\u001b[20;51Hienta qu\u001b[20;60H corre\u001b[20;67Hel programa\u001b[20;79Hvigilando cada acceso \u001b[21;34HMakefile — Archivo c\u001b[21;55Hn las\u001b[21;61Hreglas para compilar un proyecto:\u001b[21;95Hqué de\u001b[22;34Hdirección\u001b[22;44H— Posi\u001b[22;51Hión de \u001b[22;59Hn\u001b[22;61Hdato en la memoria. El operador `&` la o\u001b[23;34Hvariable local\u001b[23;51HUna local se declara dentro de una\u001b[23;86Hfunción y exist\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[8;36H"]
[4.841966, "o", "\u001b[8;36H\u001b[38;2;97;175;239;49mu\u001b[12;34H\u001b[39;49mmalloc\u001b[12;41H— Pide un bloque de\u001b[12;61Hmemoria en el\u001b[12;75Hheap y devuel\u001b[12;89He su direcci\u001b[13;34Hámbito\u001b[13;41H— La parte del código donde\u001b[13;69Hun nombre\u001b[13;79Hes visibl\u001b[13;89H:\u001b[13;91Hel bloque \u001b[14;34HSIGABRT\u001b[14;42H— Señal\u001b[14;50Hcon la que el\u001b[14;64Hprogram\u001b[14;72H se aborta a sí mi\u001b[14;91Hmo: un\u001b[14;98H`\u001b[14;100Hs\u001b[15;34HMakefile — Archivo con las reglas para compil\u001b[15;80Hr un proyecto: qué de\u001b[16;34Hdirec\u001b[16;40Hión — Posición d\u001b[16;58Hun\u001b[16;61Hdat\u001b[16;65H en\u001b[16;69Hla\u001b[16;72Hmemoria. El op\u001b[16;87Hrador `&` la o\u001b[17;34HNULL —\u001b[17;41HValor de un puntero que no apun\u001b[17;73Ha a nada. L\u001b[17;85H dev\u001b[17;91Hlv\u001b[17;94Hn `mall\u001b[18;34Hfree —\u001b[18;41HLibera un bloque pedido con\u001b[18;69H`malloc`.\u001b[18;79HDespués, \u001b[18;89Hl\u001b[18;91Hpuntero qu\u001b[19;34Hheader — Archivo `.h` con prototipos, tipos y m\u001b[19;82Hcro\u001b[19;86H,\u001b[19;88Hque se\u001b[19;95Hi\u001b[19;97Hcluy\u001b[20;34Htypedef — Da otro nombre a\u001b[20;61Hun tipo:\u001b[20;70H`typedef\u001b[20;79Hstruct n\u001b[20;88Hdo nodo_t;`.\u001b[21;34Hbreakpoint\u001b[21;45H— Marca\u001b[21;53Hen un\u001b[21;59H línea donde el depurador\u001b[21;85Hdeti\u001b[21;90Hne el progr\u001b[22;34Hfuga de memoria — Memoria pedida con `\u001b[22;73Halloc` que\u001b[22;84Hnunc\u001b[22;89H se\u001b[22;93Hliber\u001b[22;99H: \u001b[23;35Hiol\u001b[23;39Hción de segme\u001b[23;53Hto — E\u001b[23;61Hprogram\u001b[23;69H \u001b[23;71Hcc\u001b[23;74Hdió a memoria que \u001b[23;93Ho l\u001b[23;97H cor\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[8;37H"]
[4.913365, "o", "\u001b[8;37H\u001b[38;2;97;175;239;49mn\u001b[10;35H\u001b[39;49mun\u001b[10;38Hero colgante — Puntero que apu\u001b[10;69Hta a\u001b[10;74Hmemoria que ya no es válida\u001b[11;35Hro\u001b[11;38Hotipo — La firma de una funció\u001b[11;69H sin\u001b[11;74Hsu cuerpo (`int suma(int a,\u001b[18;35Huga\u001b[18;39Hde memoria — Memoria pe\u001b[18;63Hida con `malloc` que nunca se libera: \u001b[19;34Hviolación de segmento\u001b[19;56H— El programa accedió\u001b[19;78Ha\u001b[19;81Hemoria\u001b[19;92Hno\u001b[19;95Hle cor\u001b[22;34Hdesref\u001b[22;41Hrenciar — Acceder al \u001b[22;63Hato\u001b[22;67Hal que apunta \u001b[22;82Hn\u001b[22;84Hp\u001b[22;87Htero,\u001b[22;93Hcon `*p`\u001b[23;34Hfree — Libera un bloque\u001b[23;58Hpedid\u001b[23;64H con `malloc`. Después,\u001b[23;88Hel puntero qu\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[8;38H"]
[4.984872, "o", "\u001b[8;38H\u001b[38;2;97;175;239;49mt\u001b[12;34H\u001b[39;49mNULL —\u001b[12;41HValor de un puntero\u001b[12;61Hque no apunta\u001b[12;75Ha nada. Lo de\u001b[12;89Huelven `mall\u001b[13;34HSIGABRT — Señ\u001b[13;48Hl con \u001b[13;55Ha que el programa se aborta a sí mismo: un `as\u001b[14;34Htypedef\u001b[14;44HDa otro \u001b[14;53Hombre a\u001b[14;61Hun\u001b[14;64Htipo: `typ\u001b[14;75Hdef s\u001b[14;81Hruct nodo n\u001b[14;93Hdo_t;\u001b[14;99H. \u001b[17;34Hviolación de\u001b[17;47Hs\u001b[17;49Hgmento — El\u001b[17;61Hprogram\u001b[17;69H accedió \u001b[17;79H memoria q\u001b[17;91H no le cor\u001b[18;34Hdesref\u001b[18;41Hrenciar — Acceder al \u001b[18;63Hato\u001b[18;67Hal que apunta \u001b[18;82Hn\u001b[18;84Hp\u001b[18;87Htero,\u001b[18;93Hcon `*p`\u001b[19;34Hfree — Libera un bloque\u001b[19;58Hpedid\u001b[19;64H con `malloc`. Después,\u001b[19;88Hel puntero qu\u001b[20;34Hbreakpoint —\u001b[20;47HMa\u001b[20;50Hca en una lí\u001b[20;63Hea d\u001b[20;68Hnde el \u001b[20;77Hpurador detiene el progr\u001b[21;34Hdepurador — Her\u001b[21;50Hami\u001b[21;55Hta para \u001b[21;64Hjecutar\u001b[21;75Hprog\u001b[21;81Hma paso a paso\u001b[21;96Hy ve\u001b[22;34Hh\u001b[22;36Hap — Zo\u001b[22;44Ha de\u001b[22;49Hmemoria que se pide en tiempo de ejecución con `mall\u001b[23;34Henlazador — Etapa que junta l\u001b[23;64Hs `.o\u001b[23;70H y \u001b[23;74Has bibliotecas en el \u001b[23;96Hjecut\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[8;39H"]
[5.056399, "o", "\u001b[8;39H\u001b[38;2;97;175;239;49me\u001b[11;34H\u001b[39;49mdirecc\u001b[11;41Hón\u001b[11;46HPosición\u001b[11;60H dato en la memoria. El\u001b[11;84Hoperador `&` la o\u001b[13;34Hprototipo\u001b[13;44H— L\u001b[13;48H firma de \u001b[13;59Hna función sin su cuerpo (`int \u001b[13;91Huma(i\u001b[13;97Ht \u001b[13;100H,\u001b[14;34HSIGABRT\u001b[14;44HSeñal co\u001b[14;53H la que\u001b[14;61Hel\u001b[14;64Hprograma s\u001b[14;75H abor\u001b[14;81Ha a sí mism\u001b[14;93H: un \u001b[14;99Has\u001b[15;34Htyp\u001b[15;38Hdef — Da otro nombre a\u001b[15;61Hun tipo: `typedef str\u001b[15;83Hct n\u001b[15;88Hdo n\u001b[15;93Hdo_t;`. \u001b[16;34HMak\u001b[16;38Hfile — Arch\u001b[16;50Hvo con las\u001b[16;61Hreglas para comp\u001b[16;78Hlar un \u001b[16;86Hroyecto: qué de\u001b[18;34Hfree — Liber\u001b[18;47H un\u001b[18;51Hbloqu\u001b[18;57H pedi\u001b[18;63Ho con `malloc`. Después, \u001b[18;89Hl puntero qu\u001b[19;34Hdepurador — Herramienta\u001b[19;59Hara ejecutar e\u001b[19;74H programa paso a\u001b[19;92Haso y ver\u001b[20;34Hdesreferenciar — Acceder a\u001b[20;61H dato al qu\u001b[20;73H apunta un pun\u001b[20;88Hero,\u001b[20;93Hcon `*p`\u001b[21;34Hbreakpoint — Ma\u001b[21;50Hca \u001b[21;55H una lín\u001b[21;64Ha donde\u001b[21;75Hdepu\u001b[21;81Hdor detiene el\u001b[21;96Hprog\u001b[23;34Hsizeof — Operador\u001b[23;56Hda el\u001b[23;62Htamaño en bytes de un tipo\u001b[23;89Ho variable. \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[8;40H"]
[5.127802, "o", "\u001b[8;40H\u001b[38;2;97;175;239;49mr\u001b[11;34H\u001b[39;49mNULL — Valor de un puntero\u001b[11;61Hque no apunta a n\u001b[11;79Hda. L\u001b[11;85H devuelven `m\u001b[11;99Hll\u001b[12;34Hdirección — Posición de un\u001b[12;61Hdato en la memori\u001b[12;79H. El \u001b[12;85Hperador `&` l\u001b[12;99H o\u001b[13;34Hf\u001b[13;36Hee — Libera un bloqu\u001b[13;58Hpedido \u001b[13;66Hon `malloc`. Después, el puntero\u001b[13;99Hqu\u001b[14;34Htypedef\u001b[14;44HDa otro \u001b[14;53Hombre a\u001b[14;61Hun\u001b[14;64Htipo: `typ\u001b[14;75Hdef s\u001b[14;81Hruct nodo n\u001b[14;93Hdo_t;\u001b[14;99H. \u001b[15;34Hdesreferenciar — Acceder\u001b[15;60Hl da\u001b[15;65Ho al\u001b[15;70Hque apunta un pu\u001b[15;87Htero, c\u001b[15;95Hn `*p`\u001b[16;34Hdepurador — Herramienta para ejecut\u001b[16;71H el programa pas\u001b[16;88H a paso y ver\u001b[17;34Hbreakpoi\u001b[17;43Ht —\u001b[17;47HMarca en\u001b[17;56Huna línea donde el depurador detiene el prog\u001b[18;34Hsiz\u001b[18;38Hof\u001b[18;41H— Operador que da \u001b[18;60Hl tamaño\u001b[18;69Hen bytes de un tipo o\u001b[18;91Hvariable. \u001b[19;34Henlaz\u001b[19;46HEtap\u001b[19;51H que junta los `.o` y \u001b[19;74Has bibliotecas\u001b[19;89Hen el ejecut\u001b[20;34H              \u001b[20;49H \u001b[20;51H       \u001b[20;59H  \u001b[20;62H    \u001b[20;67H  \u001b[20;70H   \u001b[20;74H      \u001b[20;81H  \u001b[20;84H        \u001b[20;93H   \u001b[20;97H    \u001b[21;34H          \u001b[21;45H \u001b[21;47H     \u001b[21;53H  \u001b[21;56H   \u001b[21;60H     \u001b[21;66H     \u001b[21;72H  \u001b[21;75H         \u001b[21;85H       \u001b[21;93H  \u001b[21;96H     \u001b[22;34H    \u001b[22;39H \u001b[22;41H    \u001b[22;46H  \u001b[22;49H       \u001b[22;57H   \u001b[22;61H  \u001b[22;64H    \u001b[22;69H  \u001b[22;72H      \u001b[22;79H  \u001b[22;82H         \u001b[22;92H   \u001b[22;96H     \u001b[23;34H      \u001b[23;41H \u001b[23;43H        \u001b[23;52H   \u001b[23;56H  \u001b[23;