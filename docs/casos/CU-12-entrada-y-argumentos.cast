[1.278675, "o", "\u001b[8;37H\u001b[38;2;97;175;239;49me\u001b[15;34H\u001b[39;49mC\u001b[15;36Hrrer u\u001b[15;43H objetivo\u001b[15;53Hde\u001b[15;56Hmake…\u001b[15;92H\u001b[38;2;110;118;129;49mShift+F9\u001b[16;34H\u001b[39;49mVe\u001b[16;37H \u001b[16;39Hjercicios y \u001b[16;52Hbj\u001b[16;55Htivos del\u001b[16;65Hproyecto\u001b[16;92H   \u001b[38;2;110;118;129;49mAlt+Y\u001b[17;35H\u001b[39;49misor hexadecimal (ejecutabl\u001b[17;63Hs, .\u001b[17;68H, .a)…\u001b[17;95H     \u001b[18;34Htetsuo: Ejecutar con sanitiz\u001b[18;63Hrs\u001b[18;66H(tetsuo run)\u001b[18;89H\u001b[38;2;110;118;129;49mherramienta\u001b[19;34H\u001b[39;49mR\u001b[19;36Hglas de la cátedra\u001b[19;55H(catálogo con ejemplos\u001b[19;78H…\u001b[19;89H           \u001b[20;34Hmake: gener\u001b[20;46Hl › cle\u001b[20;54Hn — Borra objetos y ejecutables\u001b[20;90H\u001b[38;2;110;118;129;49mmake clean\u001b[21;40H\u001b[39;49mgeneral › \u001b[21;51Hll\u001b[21;54H— Compila la bibliotec\u001b[21;77H y todos los ejercicios\u001b[38;2;110;118;129;49mm\u001b[22;40H\u001b[39;49mbibl\u001b[22;45Ho\u001b[22;48Hca vector\u001b[22;58H› clean — Borra objetos, la biblioteca y la\u001b[23;50Htest — Cor\u001b[23;61He las pruebas d\u001b[23;77H la \u001b[23;82Hiblioteca y de los \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[8;38H"]
