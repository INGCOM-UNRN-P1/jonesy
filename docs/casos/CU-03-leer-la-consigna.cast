[13.483087, "o", "m  4\u001b[7;1H\u001b[38;2;97;175;239;49m│   \u001b[38;2;152;195;121;48;2;36;40;47mejercicios/ej1-promedio\u001b[39;49m):\u001b[7;33H\u001b[38;2;97;175;239;49m│\u001b[7;35H\u001b[38;2;110;118;129;49m  5\u001b[7;40H\u001b[38;2;224;108;117;49m#include \u001b[38;2;152;195;121;49m\"promedio.h\"\u001b[8;1H\u001b[38;2;97;175;239;49m│   \u001b[39;49mleer\u001b[8;10H\u001b[38;2;152;195;121;48;2;36;40;47mn\u001b[8;12H\u001b[39;49my\u001b[8;14Hdespués\u001b[8;22H\u001b[38;2;152;195;121;48;2;36;40;47mn\u001b[8;24H\u001b[39;49menteros,\u001b[8;33H\u001b[38;2;97;175;239;49m│\u001b[8;35H\u001b[38;2;110;118;129;49m  6\u001b[9;1H\u001b[38;2;97;175;239;49m│   \u001b[39;49me\u001b[9;7Himprimir su promedio\u001b[9;28Hcon\u001b[9;33H\u001b[38;2;97;175;239;49m│\u001b[9;35H\u001b[38;2;110;118;129;49m  7\u001b[9;40H\u001b[38;2;224;108;117;49m#define MAXIMO 100\u001b[10;1H\u001b[38;2;97;175;239;49m│   \u001b[39;49mdos\u001b[10;9Hdecimales.\u001b[10;20HUsá\u001b[10;33H\u001b[38;2;97;175;239;49m│\u001b[10;35H\u001b[38;2;110;118;129;49m  8\u001b[11;1H\u001b[38;2;97;175;239;49m│   \u001b[38;2;152;195;121;48;2;36;40;47mvector_suma\u001b[39;49m de la\u001b[11;33H\u001b[38;2;97;175;239;49m│\u001b[11;35H\u001b[38;2;110;118;129;49m  9\u001b[11;40H\u001b[38;2;229;192;123;49mint\u001b[11;44H\u001b[38;2;97;175;239;49mmain\u001b[39;49m(\u001b[38;2;229;192;123;49mvoid\u001b[39;49m)\u001b[12;1H\u001b[38;2;97;175;239;49m│   \u001b[39;49mbiblioteca.\u001b[12;33H\u001b[38;2;97;175;239;49m│\u001b[12;35H\u001b[38;2;110;118;129;49m 10\u001b[12;40H\u001b[39;49m{\u001b[13;1H\u001b[38;2;97;175;239;49m│2. \u001b[1m\u001b[39;49mIntercambio\u001b[22m (             \u001b[13;33H\u001b[38;2;97;175;239;49m│\u001b[13;35H\u001b[38;2;110;118;129;49m 11\u001b[13;44H\u001b[38;2;229;192;123;49mint\u001b[13;48H\u001b[39;49mnumeros[MAXIMO];\u001b[14;1H\u001b[38;2;97;175;239;49m│   \u001b[38;2;152;195;121;48;2;36;40;47mejercicios/ej2-intercambio\u001b[39;49m):\u001b[38;2;97;175;239;49m│\u001b[14;35H\u001b[38;2