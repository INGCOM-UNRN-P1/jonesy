[21.518679, "o", "\u001b[2;102H\u001b[38;2;110;118;129;49mfree ─────\u001b[3;101H\u001b[1m\u001b[38;2;97;175;239;49mvoid free(void *ptr)\u001b[22m\u001b[39;49m         \u001b[4;101H\u001b[38;2;110;118;129;49m#include <stdlib.h>\u001b[5;101H\u001b[39;49mLibera\u001b[5;108Hun\u001b[5;111Hbloque\u001b[5;118Hde\u001b[5;121Hmemoria\u001b[6;101Hdinámica.\u001b[7;101H\u001b[1mRetorno: \u001b[22mNo\u001b[7;113Hdevuelve\u001b[7;122Hnada.\u001b[8;103Hvoid\u001b[8;108H*\u001b[8;110Hptr\u001b[38;2;110;118;129;49m — Bloque devuelto\u001b[9;101Hpor malloc/calloc/realloc, o\u001b[10;101HNULL (no hace nada).\u001b[11;101H\u001b[38;2;229;192;123;49m⚠ Después de free, asigná NULL\u001b[12;101Hal puntero para no usarlo\u001b[13;101Hcolgado.\u001b[14;101H⚠ Liberar dos veces el mismo\u001b[15;101Hbloque es comportamiento\u001b[16;101Hindefinido.\u001b[17;101H⚠ En estructuras enlazadas,\u001b[18;101Hliberá los nodos internos antes\u001b[19;43H\u001b[39;48;2;33;37;43me\u001b[19;101H\u001b[38;2;229;192;123;49mque el contenedor.\u001b[20;101H⚠ No liberes memoria que no\u001b[21;101Hvino de malloc (arreglos\u001b[22;101Hlocales, literales).\u001b[23;101H\u001b[38;2;198;120;221;49mReglas: 0x3002h, 0x300Fh\u001b[36;21H\u001b[38;2;110;118;129;48;2;40;44;52m9\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[19;44H"]
