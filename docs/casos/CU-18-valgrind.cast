[26.068876, "o", "\u001b[7;32H.\u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[38;2;110;118;129;49m  5\u001b[39;49m                                                              \u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[8;32H \u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[38;2;110;118;129;49m  6\u001b[38;2;229;192;123;49m▎\u001b[39;49m \u001b[38;2;97;175;239;49mmain\u001b[39;49m(\u001b[38;2;229;192;123;49mvoid\u001b[39;49m)   \u001b[3m\u001b[38;2;229;192;123;49m▲ La función 'main' contiene más de un return (\u001b[23m\u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[9;32H \u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[38;2;110;118;129;49m  7\u001b[39;49m                                                              \u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[10;32H\u001b[38;2;86;182;194;49m─\u001b[38;2;110;118;129;49m│\u001b[10;35H  8\u001b[38;2;229;192;123;49m▎\u001b[10;40Hint\u001b[10;44H\u001b[39;49moriginal[]\u001b[10;55H=\u001b[10;57H{\u001b[4m\u001b[38;2;229;192;123;49m10\u001b[24m\u001b[39;49m,\u001b[10;62H\u001b[38;2;209;154;102;49m20\u001b[39;49m,\u001b[10;66H\u001b[38;2;209;154;102;49m30\u001b[39;49m};\u001b[10;73H\u001b[3m\u001b[38;2;229;192;123;49m▲ Número mágico '10' sin co\u001b[23m\u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[11;32H \u001b[38;2;110;118;129;49m│\u001b[11;35H  9\u001b[38;2;229;192;123;49m▎\u001b[11;40Hint\u001b[11;44H\u001b[39;49m*copia\u001b[11;51H=\u001b[11;53H\u001b[38;2;97;175;239;49mcopiar\u001b[39;49m(original,\u001b[11;70H\u001b[4m\u001b[38;2;229;192;123;49m3\u001b[24m\u001b[39;49m);\u001b[11;76H\u001b[3m\u001b[38;2;229;192;123;49m▲ Número mágico '3' sin \u001b[23m\u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[12;32H \u001b[38;2;110;118;129;49m│\u001b[12;35H 10\u001b[38;2;229;192;123;49m▎\u001b[12;40H\u001b[38;2;198;120;221;49mif\u001b[12;43H\u001b[39;49m(copia\u001b[12;50H==\u001b[12;53H\u001b[38;2;198;120;221;49mNULL\u001b[39;49m)\u001b[12;61H\u001b[3m\u001b[38;2;229;192;123;49m▲ Manejo de error de archivo sin invoca\u001b[23m\u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[13;32H \u001b[38;2;110;118;129;49m│\u001b[13;35H 11\u001b[13;40H\u001b[39;49m{\u001b[13;100H\u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[14;32H \u001b[38;2;110;118;129;49m│\u001b[14;35H 12\u001b[14;44H\u001b[38;2;97;175;239;49mprintf\u001b[39;49m(\u001b[38;2;152;195;121;49m\"No hay memoria.\\n\"\u001b[39;49m);\u001b[14;100H\u001b[38;2;110;118;129;49m│\u001b[39;49m \u001b[15;32H \u001b[38;2;110;118;129;49m│\u001b[15;35H 13\u001b[15;44H\u001b[38;2;198;120;221;49mreturn\u001b[15;51H\u001b[38;2;209;154;102;49m1\u001b[39;49m;\u001b[15;100H\u001b[38;2;110;118;"]
