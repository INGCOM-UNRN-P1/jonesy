[11.147697, "o", "\u001b[3;34H \u001b[38;5;15;49m  1\u001b[39;49m  \u001b[38;2;224;108;117;49m#define _POSIX_C_SOURCE 200809L\u001b[39;49m                             \u001b[7;32H\u001b[38;2;97;175;239;49m┌ Comandos ──────────────────────────────────────────────────────────┐\u001b[8;32H│> \u001b[39;49m   \u001b[8;100H \u001b[38;2;97;175;239;49m│\u001b[9;32H│\u001b[1m\u001b[39;48;2;62;68;81m Compilar archivo o proyecto                                     \u001b[38;2;110;118;129;48;2;62;68;81mF6 \u001b[22m\u001b[38;2;97;175;239;49m│\u001b[10;32H│\u001b[39;49m Compilar\u001b[10;43Hy\u001b[10;45Hejecutar\u001b[10;93H\u001b[38;2;110;118;129;49mCtrl+F5 \u001b[38;2;97;175;239;49m│\u001b[11;32H│\u001b[39;49m Correr pruebas (make\u001b[11;55Htest)\u001b[11;93H\u001b[38;2;110;118;129;49mCtrl+F6 \u001b[38;2;97;175;239;49m│\u001b[12;32H│\u001b[39;49m Revisar\u001b[12;42Hmemoria\u001b[12;50Hcon\u001b[12;54Hvalgrind\u001b[12;63H(fugas\u001b[12;70Hy\u001b[12;72Haccesos)\u001b[12;100H\u001b[38;2;110;118;129;49m \u001b[38;2;97;175;239;49m│\u001b[13;32H│\u001b[39;49m Iniciar\u001b[13;42Hdepuración / continuar\u001b[13;98H\u001b[38;2;110;118;129;49mF5 \u001b[38;2;97;175;239;49m│\u001b[14;32H│\u001b[39;49m Paso\u001b[14;39Ha\u001b[14;41Hpaso (siguiente\u001b[14;57Hlínea)\u001b[14;97H\u001b[38;2;110;118;129;49mF10 \u001b[38;2;97;175;239;49m│\u001b[15;32H│\u001b[39;49m Entrar\u001b[15;41Hen\u001b[15;44Hla función\u001b[15;55H(step\u001b[15;61Hinto)\u001b[15;97H\u001b[38;2;110;118;129;49mF11 \u001b[38;2;97;175;239;49m│\u001b[16;32H│\u001b[39;49m Salir\u001b[16;40Hde\u001b[16;43Hla función \u001b[16;55Hstep out)     \u001b[16;91H\u001b[38;2;110;118;129;49mShift+F11 \u001b[38;2;97;175;239;49m│\u001b[17;32H│\u001b[39;49m Detener\u001b[17;42Hdepuración\u001b[17;92H\u001b[38;2;110;118;129;49mShift+F5 \u001b[38;2;97;175;239;49m│\u001b[18;32H│\u001b[39;49m Poner\u001b[18;40H/\u001b[18;42Hquitar breakpoint                     \u001b[18;94H\u001b[38;2;110;118;129;49mCtrl+B \u001b[38;2;97;175;239;4